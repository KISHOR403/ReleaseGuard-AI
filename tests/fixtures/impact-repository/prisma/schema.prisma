datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Payment {
  id        Int      @id @default(autoincrement())
  amount    Float
  currency  String
  status    String
  createdAt DateTime @default(now())
}

model Order {
  id        Int      @id @default(autoincrement())
  total     Float
  paymentId Int
  status    String
}
